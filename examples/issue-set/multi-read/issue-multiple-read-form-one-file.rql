# Dwie deklaracje czytaja ten sam plik niezaleznie: co 1/5 s i co 1 s.
# file.dat zawiera osiem liczb INTEGER (int32): 1..8, zapetlanych po EOF.
# Uruchom z tego katalogu: xretractor -q issue-multiple-read-form-one-file.rql -f -m 2000 -k
# fast i slow maja te same kolejne wartosci, ale rozne liczby rekordow.
# d1 przeplata piec wartosci adata ze stalym 77; d2 odzyskuje adata,
# a d3 odzyskuje d0. Argument & / % to interwal USUWANEGO skladnika.
# Ogon rozplotu ogranicza dlugosc d2 przy skonczonym budzecie iteracji;
# nie oznacza to luk w jego sekwencji wartosci.

DECLARE b INTEGER STREAM adata,1/5 BINFILE 'file.dat'
DECLARE d INTEGER STREAM bdata,1 BINFILE 'file.dat'

SELECT * STREAM fast FROM adata
SELECT * STREAM slow FROM bdata
SELECT 77 STREAM d0 FROM bdata
SELECT * STREAM d1 FROM adata#d0
SELECT * STREAM d2 FROM d1&1
SELECT * STREAM d3 FROM d1%1/5

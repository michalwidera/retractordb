:STORAGE	temp/
:SUBSTRAT	memory
NA(1/100)	axis_x.txt
	v: INTEGER
NB(1/100)	axis_y.txt
	v: INTEGER
n1(1/100)
	:- PUSH_STREAM(NA)
	:- PUSH_STREAM(NB)
	:- STREAM_ADD
	n1_0: INTEGER
		PUSH_ID(n1[0])
	n1_1: INTEGER
		PUSH_ID(n1[1])
SA(1/100)	axis_x.txt
	v: INTEGER
ZA(1/100)	axis_x.txt
	v: INTEGER
GC(1/100)	axis_y.txt
	v: INTEGER
GB(1/100)	axis_y.txt
	v: INTEGER
SB(1/100)	axis_y.txt
	v: INTEGER
GA(1/100)	axis_x.txt
	v: INTEGER
STREAM_ADD_GC_GB(1/100)
	:- PUSH_STREAM(GC)
	:- PUSH_STREAM(GB)
	:- STREAM_ADD
	GC_0: INTEGER
		PUSH_ID(STREAM_ADD_GC_GB[0])
	GB_1: INTEGER
		PUSH_ID(STREAM_ADD_GC_GB[1])
x3(1/100)
	:- PUSH_STREAM(STREAM_ADD_GC_GB)
	:- PUSH_STREAM(GA)
	:- STREAM_ADD
	x3_0: INTEGER
		PUSH_ID(x3[2])
		PUSH_ID(x3[1])
		MULTIPLY
		PUSH_ID(x3[0])
		ADD
n2(1/100)
	:- PUSH_STREAM(NB)
	:- PUSH_STREAM(NA)
	:- STREAM_ADD
	n2_0: INTEGER
		PUSH_ID(n2[0])
	n2_1: INTEGER
		PUSH_ID(n2[1])
d1(1/100)
	:- PUSH_STREAM(SA)
	:- PUSH_STREAM(SB)
	:- STREAM_ADD
	SA_0: INTEGER
		PUSH_ID(d1[0])
	SB_1: INTEGER
		PUSH_ID(d1[1])
STREAM_ADD_GA_GB(1/100)
	:- PUSH_STREAM(GA)
	:- PUSH_STREAM(GB)
	:- STREAM_ADD
	GA_0: INTEGER
		PUSH_ID(STREAM_ADD_GA_GB[0])
	GB_1: INTEGER
		PUSH_ID(STREAM_ADD_GA_GB[1])
x1(1/100)
	:- PUSH_STREAM(STREAM_ADD_GA_GB)
	:- PUSH_STREAM(GC)
	:- STREAM_ADD
	x1_0: INTEGER
		PUSH_ID(x1[0])
		PUSH_ID(x1[1])
		MULTIPLY
		PUSH_ID(x1[2])
		ADD
z1(1/100)
	:- PUSH_STREAM(ZA)
	z1_0: INTEGER
		PUSH_ID(z1[0])
		PUSH_ID(z1[0])
		MULTIPLY
		CALL(Sqrt)
z2(1/100)
	:- PUSH_STREAM(ZA)
	z2_0: INTEGER
		PUSH_ID(z2[0])
		PUSH_ID(z2[0])
		MULTIPLY
		CALL(Sqrt)
d2(1/100)
	:- PUSH_STREAM(SB)
	:- PUSH_STREAM(SA)
	:- STREAM_ADD
	SB_0: INTEGER
		PUSH_ID(d2[0])
	SA_1: INTEGER
		PUSH_ID(d2[1])

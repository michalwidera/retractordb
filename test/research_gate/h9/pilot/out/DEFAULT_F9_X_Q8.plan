:STORAGE	temp/
:SUBSTRAT	memory
A(1/100)	front_vib.txt
	front: INTEGER
B(1/50)	front_cur.txt
	front: INTEGER
STREAM_HASH_A_B(1/150)	tail=2
	:- PUSH_STREAM(A)
	:- PUSH_STREAM(B)
	:- STREAM_HASH
	front: INTEGER
		PUSH_ID(STREAM_HASH_A_B[0])
C(1/100)	rear_vib.txt
	rear: INTEGER
D(1/50)	rear_cur.txt
	rear: INTEGER
STREAM_HASH_C_D(1/150)	tail=2
	:- PUSH_STREAM(C)
	:- PUSH_STREAM(D)
	:- STREAM_HASH
	rear: INTEGER
		PUSH_ID(STREAM_HASH_C_D[0])
STREAM_HASH_STREAM_TIMEMOVE_A_STREAM_TIMEMOVE_B(1/150)	origin=3
	:- PUSH_STREAM(STREAM_HASH_A_B)
	:- STREAM_TIMEMOVE(3)
	front: INTEGER
		PUSH_ID(STREAM_HASH_STREAM_TIMEMOVE_A_STREAM_TIMEMOVE_B[0])
STREAM_HASH_STREAM_TIMEMOVE_C_STREAM_TIMEMOVE_D(1/150)	origin=3
	:- PUSH_STREAM(STREAM_HASH_C_D)
	:- STREAM_TIMEMOVE(3)
	rear: INTEGER
		PUSH_ID(STREAM_HASH_STREAM_TIMEMOVE_C_STREAM_TIMEMOVE_D[0])
STREAM_SELECT_m1(1/150)	origin=3
	:- PUSH_STREAM(STREAM_HASH_STREAM_TIMEMOVE_A_STREAM_TIMEMOVE_B)
	:- PUSH_STREAM(STREAM_HASH_STREAM_TIMEMOVE_C_STREAM_TIMEMOVE_D)
	:- STREAM_ADD
	m1_0: INTEGER
		PUSH_ID(STREAM_SELECT_m1[0])
		PUSH_ID(STREAM_SELECT_m1[0])
		MULTIPLY
		PUSH_ID(STREAM_SELECT_m1[1])
		PUSH_ID(STREAM_SELECT_m1[1])
		MULTIPLY
		ADD
		CALL(Sqrt)
m8(1/150)	origin=3
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m8_0: INTEGER
		PUSH_ID(m8[0])
m1(1/150)	origin=3
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m1_0: INTEGER
		PUSH_ID(m1[0])
m7(1/150)	origin=3
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m7_0: INTEGER
		PUSH_ID(m7[0])
m6(1/150)	origin=3
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m6_0: INTEGER
		PUSH_ID(m6[0])
m5(1/150)	origin=3
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m5_0: INTEGER
		PUSH_ID(m5[0])
m4(1/150)	origin=3
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m4_0: INTEGER
		PUSH_ID(m4[0])
m3(1/150)	origin=3
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m3_0: INTEGER
		PUSH_ID(m3[0])
m2(1/150)	origin=3
	:- PUSH_STREAM(STREAM_SELECT_m1)
	m2_0: INTEGER
		PUSH_ID(m2[0])

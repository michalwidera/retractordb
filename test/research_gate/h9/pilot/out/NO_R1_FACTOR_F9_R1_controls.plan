:SUBSTRAT	memory
:STORAGE	temp/
IA(1/100)	vib.txt
	v: INTEGER
STREAM_TIMEMOVE_IA(1/100)	origin=2
	:- PUSH_STREAM(IA)
	:- STREAM_TIMEMOVE(2)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_IA[0])
IB(1/50)	cur.txt
	v: INTEGER
STREAM_TIMEMOVE_IB(1/50)	origin=1
	:- PUSH_STREAM(IB)
	:- STREAM_TIMEMOVE(1)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_IB[0])
i1(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_TIMEMOVE_IA)
	:- PUSH_STREAM(STREAM_TIMEMOVE_IB)
	:- STREAM_HASH
	i1_0: INTEGER
		PUSH_ID(i1[0])
		PUSH_ID(i1[0])
		MULTIPLY
CA(1/100)	vib.txt
	cx: INTEGER
	cy: INTEGER
CB(1/50)	cur.txt
	cx: INTEGER
	cy: INTEGER
STREAM_HASH_CA_CB(1/150)	tail=2
	:- PUSH_STREAM(CA)
	:- PUSH_STREAM(CB)
	:- STREAM_HASH
	STREAM_HASH_CA_CB_0: INTEGER
		PUSH_ID(STREAM_HASH_CA_CB[1])
	STREAM_HASH_CA_CB_1: INTEGER
		PUSH_ID(STREAM_HASH_CA_CB[0])
IA2(1/100)	vib.txt
	v: INTEGER
IB2(1/50)	cur.txt
	v: INTEGER
STREAM_HASH_IA2_IB2(1/150)	tail=2
	:- PUSH_STREAM(IA2)
	:- PUSH_STREAM(IB2)
	:- STREAM_HASH
	v: INTEGER
		PUSH_ID(STREAM_HASH_IA2_IB2[0])
i2(1/150)	origin=3
	:- PUSH_STREAM(STREAM_HASH_IA2_IB2)
	:- STREAM_TIMEMOVE(3)
	i2_0: INTEGER
		PUSH_ID(i2[0])
		PUSH_ID(i2[0])
		MULTIPLY
STREAM_TIMEMOVE_CA(1/100)	origin=2
	:- PUSH_STREAM(CA)
	:- STREAM_TIMEMOVE(2)
	cx: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_CA[0])
	cy: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_CA[1])
STREAM_TIMEMOVE_CB(1/50)	origin=1
	:- PUSH_STREAM(CB)
	:- STREAM_TIMEMOVE(1)
	cx: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_CB[0])
	cy: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_CB[1])
collide_user(1/150)	tail=2	origin=3
	:- PUSH_STREAM(STREAM_TIMEMOVE_CA)
	:- PUSH_STREAM(STREAM_TIMEMOVE_CB)
	:- STREAM_HASH
	cx: INTEGER
		PUSH_ID(collide_user[0])
	cy: INTEGER
		PUSH_ID(collide_user[1])
MA(1/100)	vib.txt
	v: INTEGER
STREAM_TIMEMOVE_MA(1/100)	origin=2
	:- PUSH_STREAM(MA)
	:- STREAM_TIMEMOVE(2)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_MA[0])
MB(1/50)	cur.txt
	v: INTEGER
STREAM_TIMEMOVE_MB(1/50)	origin=2
	:- PUSH_STREAM(MB)
	:- STREAM_TIMEMOVE(2)
	v: INTEGER
		PUSH_ID(STREAM_TIMEMOVE_MB[0])
mm(1/150)	tail=2	origin=4
	:- PUSH_STREAM(STREAM_TIMEMOVE_MA)
	:- PUSH_STREAM(STREAM_TIMEMOVE_MB)
	:- STREAM_HASH
	mm_0: INTEGER
		PUSH_ID(mm[0])
		PUSH_ID(mm[0])
		MULTIPLY
ZA(1/100)	vib.txt
	v: INTEGER
z1(1/100)
	:- PUSH_STREAM(ZA)
	z1_0: INTEGER
		PUSH_ID(z1[0])
		PUSH_ID(z1[0])
		MULTIPLY
z2(1/100)
	:- PUSH_STREAM(ZA)
	z2_0: INTEGER
		PUSH_ID(z2[0])
		PUSH_ID(z2[0])
		MULTIPLY

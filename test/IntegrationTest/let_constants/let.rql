# Plan ze stalymi LET dla it_let_constants (#440) - ten sam co literal.rql. Jedna stala bywa
# uzyta w kilku miejscach (WINDOW_STEP, LAST_INSTANCE, OFFSET, POWER), a literal stoi obok stalej.
LET CHANNEL_COUNT = 2
LET SIGNAL_INDEX = 0
LET STATUS_INDEX = 1
LET WINDOW_STEP = 3
LET WINDOW_WIDTH = 4
LET SHIFT = 2
LET HISTORY_WIDTH = 3
LET TEXT_WIDTH = 6
LET FAMILY_SIZE = 2
LET LAST_INSTANCE = 1
LET RING_CAPACITY = 10
LET RING_SEGMENTS = 2
LET DUMP_BEFORE = 1
LET DUMP_AFTER = 2
LET DUMP_TASKS = 3
LET FAST_INTERVAL = 1/2
LET THIN_INTERVAL = 3/2
LET SLOW_INTERVAL = 2.5
LET SPLIT = 2
LET GAIN = 0.1
LET OFFSET = 2
LET POWER = 2
LET ALARM_LIMIT = 7
LET STATUS_FLOOR = 0.5
DECLARE v INTEGER[?CHANNEL_COUNT] STREAM s, 1 TEXTFILE 'data.txt'
DECLARE w INTEGER[2] STREAM fast, ?FAST_INTERVAL TEXTFILE 'data.txt'
SELECT s[?SIGNAL_INDEX], s[?STATUS_INDEX] STREAM channels FROM s
SELECT * STREAM block FROM channels@(?WINDOW_STEP, -?WINDOW_WIDTH)
SELECT * STREAM block2 FROM channels@(2, ?WINDOW_WIDTH)
SELECT * STREAM shifted FROM channels > ?SHIFT
SELECT AVG(channels[?SIGNAL_INDEX] : ?HISTORY_WIDTH), to_string(channels[?STATUS_INDEX] : ?TEXT_WIDTH) STREAM means FROM channels
SELECT channels[?LAST_INSTANCE-$] STREAM fam[?FAMILY_SIZE] FROM channels
SELECT * STREAM kept FROM fam[?LAST_INSTANCE] RETENTION ?RING_CAPACITY ?RING_SEGMENTS
SELECT * STREAM thin FROM channels - ?THIN_INTERVAL
SELECT * STREAM slow FROM channels - ?SLOW_INTERVAL
SELECT * STREAM part FROM fast & ?SPLIT
SELECT channels[0]*?GAIN + -?OFFSET, -?OFFSET^?POWER, channels[1]^?POWER STREAM scaled FROM channels
RULE high ON channels WHEN channels[0] >= ?ALARM_LIMIT AND channels[1] > ?STATUS_FLOOR DO DUMP -?DUMP_BEFORE TO ?DUMP_AFTER RETENTION ?DUMP_TASKS

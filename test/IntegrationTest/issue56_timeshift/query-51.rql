# Check if fields are identified correctly - Covering #issue_57
# make install ; ctest -R issue57_timeshift -V

STORAGE 'temp'

DECLARE a INTEGER STREAM shift_core0, 0.1 FILE 'datafile2.dat'
DECLARE b INTEGER STREAM shift_core1, 0.2 FILE 'datafile3.dat'

SELECT shift_str1[0]*10,shift_str1[1]*10,shift_str1[1]*shift_str1[0]+20 STREAM shift_str1 FROM (shift_core0+shift_core1)>5

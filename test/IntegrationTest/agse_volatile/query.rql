# Regresja: AGSE nad strumieniem VOLATILE (bufor MEMORY) musi widziec cale okno.
#
# win2 czyta okno 3 pol ze strumienia mid, ktory ma wlasny ogon (jest wynikiem
# okna win1). Pojemnosc bufora mid musi pomiescic oba konce zakresu okna —
# przy zbyt malej pojemnosci kolowy bufor nadpisuje najstarsze pole i AGSE
# czyta w jego miejsce rekord najnowszy (okno [x_n, x_n-1, x_n+1]).

DECLARE value INTEGER STREAM source, 1 FILE 'data.txt'

SELECT * STREAM win1 FROM source@(1,3) VOLATILE
SELECT win1[0] STREAM mid FROM win1 VOLATILE
SELECT * STREAM win2 FROM mid@(1,3) VOLATILE
SELECT win2[0], win2[1], win2[2] STREAM win_out FROM win2

# Plan jest tu nosnikiem: badane jest przyjmowanie resetow w trakcie wymiany planu,
# a nie to, co silnik liczy. Nazwy strumieni musza sie miedzy planami roznic, bo to
# po nich (przez --bus) rozpoznajemy, ktory plan faktycznie wszedl.

STORAGE 'temp'

DECLARE a INTEGER STREAM src, 1 FILE 'data.txt'

SELECT a+1 STREAM alpha1 FROM src
SELECT a+2 STREAM alpha2 FROM src
SELECT a+3 STREAM alpha3 FROM src
SELECT a+4 STREAM alpha4 FROM src

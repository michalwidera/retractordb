# Plan odrzucany przez `xqry --reset` (D4): FLOAT do zmiennej INTEGER. Odmowa nie moze zmienic
# dzialajacego planu ani wartosci jego zmiennych.
STORAGE 'temp_bad'
VAR LATCH = 0
DECLARE v INTEGER STREAM src, 1/10 TEXTFILE 'data.txt'
SELECT src[0], ?LATCH STREAM st_bad FROM src
RULE latch_on ON st_bad WHEN st_bad[0] >= 250 DO SET ?LATCH = 0.5

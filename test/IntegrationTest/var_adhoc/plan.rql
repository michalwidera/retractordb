# Plan testu it_var_adhoc (#531, etap C): zatrzask z histereza 250/200 i licznik, ktory pisze
# dopiero regula dolaczona ad hoc. Wartosc 220 lezy w pasmie i trzyma zatrzask.
STORAGE 'temp'
LET T_ON = 250
LET T_OFF = 200
VAR LATCH = 0
VAR COUNT = 0
DECLARE v INTEGER STREAM src, 1/10 TEXTFILE 'data.txt'
SELECT src[0], ?LATCH, ?COUNT STREAM st FROM src
RULE latch_on ON st WHEN st[0] >= ?T_ON DO SET ?LATCH = 1
RULE latch_off ON st WHEN st[0] < ?T_OFF DO SET ?LATCH = 0

# Wariant pomiarowy S3/R5: AVG zamiast EMA. LTA nie jest zamrazana.
# To inny algorytm detektora; nie twierdzimy, ze jego wartosci sa rowne query.rql.
STORAGE 'temp'
VAR TRIG = 0
DECLARE a INTEGER STREAM acc, 1/100 TEXTFILE 'acc.txt'
SELECT acc[0], to_float(AVG(Abs(acc[0]) : 10)), to_float(AVG(Abs(acc[0]) : 1000)), ?TRIG STREAM detector FROM acc
RULE onset_dump ON detector WHEN ?TRIG = 0 AND detector[1] > (4 * detector[2]) DO DUMP -500 TO 1000
RULE trig_on ON detector WHEN detector[1] > (4 * detector[2]) DO SET ?TRIG = 1
RULE trig_off ON detector WHEN detector[1] < (1.5 * detector[2]) DO SET ?TRIG = 0

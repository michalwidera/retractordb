# Plan jest tu nosnikiem: badana jest droga komendy `get` w chwili wymiany planu,
# a nie to, co liczy silnik. Osiem strumieni po to, zeby handler `get` mial realna
# prace do wykonania po zdjeciu haka opozniajacego.

STORAGE 'temp'

DECLARE a INTEGER STREAM src, 1 FILE 'data.txt'

SELECT a+1 STREAM alpha1 FROM src
SELECT a+2 STREAM alpha2 FROM src
SELECT a+3 STREAM alpha3 FROM src
SELECT a+4 STREAM alpha4 FROM src
SELECT a+5 STREAM alpha5 FROM src
SELECT a+6 STREAM alpha6 FROM src
SELECT a+7 STREAM alpha7 FROM src
SELECT a+8 STREAM alpha8 FROM src

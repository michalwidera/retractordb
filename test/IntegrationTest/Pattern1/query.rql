# declaration of input time series
declare a INTEGER,b INTEGER stream core0, 1 file 'datafile2.dat'
declare c INTEGER,d INTEGER stream core1, 0.5 file 'datafile3.dat'

# time series junction
# Bylo: `select core0[0],core1[1] ...` — po przeplocie skladniki dziela jeden schemat,
# wiec oba odwolania wskazywaly te sama pozycje str1. Od bramki F9 (D-F1 = S3) taki zapis
# jest bledem kompilacji; ponizszy liczy dokladnie to samo, tylko bez dwuznacznosci.
select str1[0],str1[1] stream str1 from core0#core1
select (core1[0]+1)*2+1,1 stream str2 from core1-1/2
select core0[0],core0[1] stream str3 from core1+core0

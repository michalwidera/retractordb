STORAGE 'temp'

DECLARE a INTEGER STREAM max_core0, 0.1 FILE 'datafile2.dat'
DECLARE b INTEGER STREAM max_core1, 0.2 FILE 'datafile3.dat'

SELECT max_str0[0]*10,(max_str0[1]+10)*10 STREAM max_str0 FROM max_core0+max_core1
SELECT max_str1[0] STREAM max_str1 FROM max_str0.max
SELECT * STREAM max_str2 FROM max_str0 + max_str1

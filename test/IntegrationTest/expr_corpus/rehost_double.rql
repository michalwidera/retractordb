# Wyrazenia z list SELECT planow testow systemowych, przeniesione na wspolne zrodlo DOUBLE.
STORAGE 'temp'

DECLARE x DOUBLE, y DOUBLE, z DOUBLE STREAM src, 1 FILE 'rehost_double.txt'

SELECT src[0] / 2, int(src[0]/1000), src[0]^2/1000, src[0]-900, (src[0]-src[0]*2)*5, src[0]*5, src[0]/25/100, src[0] + src[1]/20, src[1]-src[0], src[0]/2+1, src[0]+1, (src[0]+1)*2+1, src[0]*10, src[0]+10, src[1]+1, src[0]+100, src[0]+200, src[0]-src[0], int(src[0]/25/1000), src[0]*3, to_integer(src[0])+1, src[0]+src[0]+src[0], src[0]+src[1]+src[1], src[0]+src[0]+src[0]+src[0], src[0] + src[0]/20, src[1]*10, src[1]*src[0]+20, (src[1]+10)*10, src[0]+2, src[0]+4, src[0]+6, src[0]+3, src[0]+5, src[0]+11, src[0]+7, src[0]+8, src[0]+12, src[0]+13, src[0]*2, 100/src[0], src[0]*src[0], src[1] + 1 + 2, src[0] + 1 + 2, src[0]*1, src[0]*4, src[0]*6, src[0]*7, src[0]*8, src[0] * 200000000, src[0] * 1000000000, src[0] + 2147483638, src[0] + 2147483639, src[0] / 1000000000 / 2, src[0] / 1000000000 / 7, src[0] * 300000000, src[0] + 2147483640, src[0] + 2147483641, to_integer(src[0] * 10000000000.0), to_integer(src[0] * 100000000.0), Sqrt(src[0] - 10), src[0] - 2, src[0] - 3, src[0] * 2, src[0]/(src[0]-src[0]), null2zero(src[0]/(src[0]-src[0])), src[0] * 10, Sqrt(src[0]*src[0]+src[0]*src[0]), src[0]*src[0]+src[0], Sqrt(src[0]*src[0]), Sqrt(src[0]*src[0]+src[1]*src[1]) STREAM sysx FROM src

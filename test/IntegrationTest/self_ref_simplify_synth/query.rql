# Wezly SYNTETYZUJACE schemat (`@` i reduktor): `w[k]`, `r[k]` i `core1[k]` w programie pola to slot k
# rekordu wejsciowego, ktory ma typ NAJSZERSZY z rekordu `core1` — tu FLOAT. Ani wlasne pole wyjsciowe
# (do 2026-09-14 INTEGER), ani pole `core1.c` (INTEGER).

STORAGE 'temp'

DECLARE c INTEGER, d FLOAT \
STREAM core1, 0.1 \
FILE 'sensor.txt'

SELECT w[1] + 1 + 2, core1[1] + 1 + 2 \
STREAM w \
FROM core1@(1,2)

SELECT r[0] + 1 + 2, core1[0] + 1 + 2 \
STREAM r \
FROM core1.max

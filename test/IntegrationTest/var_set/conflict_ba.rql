# Konflikt zapisu (#531, D3): te same reguly co w conflict_ab.rql w odwrotnej kolejnosci tekstu -
# wygrywa r_down.
STORAGE 'temp'
VAR X = 0
DECLARE a INTEGER STREAM src, 1 TEXTFILE 'conflict.txt'
SELECT src[0], ?X STREAM up FROM src
SELECT up[0], ?X STREAM down FROM up
RULE r_up ON up WHEN up[0] > 50 DO SET ?X = 0 - up[0]
RULE r_down ON down WHEN down[0] > 0 DO SET ?X = down[0]

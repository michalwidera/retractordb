# Ten sam defekt w postaci, ktora dawala ZLA WARTOSC: baza `core1` w `merged` wynosi 2,
# a nie 0. W reject.rql pierwsze trafia `core0[0]`, ktorego baza przypadkiem jest 0.

STORAGE 'temp'

DECLARE a BYTE, b INTEGER \
STREAM core0, 0.1 \
FILE 'sensor_a.txt'

DECLARE c INTEGER, d FLOAT \
STREAM core1, 0.2 \
FILE 'sensor_b.txt'

SELECT * \
STREAM merged \
FROM core0 + core1

SELECT merged[0], core1[0] \
STREAM result \
FROM merged

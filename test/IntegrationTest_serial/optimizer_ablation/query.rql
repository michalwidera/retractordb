STORAGE 'temp'
SUBSTRAT 'memory'

# Syntaktycznie identyczne i przemiennie równoważne SELECT-y.
DECLARE value INTEGER STREAM A, 0.1 FILE 'a.txt'
DECLARE value INTEGER STREAM B, 0.2 FILE 'b.txt'

SELECT A[0]*B[0] STREAM same1 FROM A+B
SELECT A[0]*B[0] STREAM same2 FROM A+B
SELECT A[0]*B[0] STREAM commuted FROM B+A

# Dopasowane przesunięcia przed # oraz jawna prawa strona tożsamości.
DECLARE value INTEGER STREAM FA, 0.1 FILE 'a.txt'
DECLARE value INTEGER STREAM FB, 0.2 FILE 'b.txt'
DECLARE value INTEGER STREAM FA2, 0.1 FILE 'a.txt'
DECLARE value INTEGER STREAM FB2, 0.2 FILE 'b.txt'

SELECT * STREAM factored FROM (FA>2)#(FB>1)
SELECT * STREAM factor_reference FROM (FA2#FB2)>3

# Substrat przesunięcia z dwoma konsumentami: jeden pasuje do wzorca reguły,
# drugi nie. Reguła wolno przepisać wyłącznie pierwszego. Dawniej cały ten
# przypadek był poza zasięgiem reguły, bo wymagała ona dokładnie jednego
# konsumenta; przepisanie w miejscu podstawiłoby tu przeplot pod mixed_shift.
DECLARE value INTEGER STREAM MA, 0.1 FILE 'a.txt'
DECLARE value INTEGER STREAM MB, 0.2 FILE 'b.txt'
DECLARE value INTEGER STREAM MA2, 0.1 FILE 'a.txt'
DECLARE value INTEGER STREAM MB2, 0.2 FILE 'b.txt'

SELECT * STREAM mixed_hash FROM (MA>2)#(MB>1)
SELECT * STREAM mixed_shift FROM (MA>2)+MB
SELECT * STREAM mixed_shift_reference FROM (MA2>2)+MB2

# Dwa zapytania nad tym samym przesuniętym przeplotem. Warunek jednego
# konsumenta wyłączał tu regułę całkowicie, czyli dokładnie w reżimie
# wielozapytaniowym, o który pyta krok K5 planu badawczego.
DECLARE value INTEGER STREAM QA, 0.1 FILE 'a.txt'
DECLARE value INTEGER STREAM QB, 0.2 FILE 'b.txt'
DECLARE value INTEGER STREAM QA2, 0.1 FILE 'a.txt'
DECLARE value INTEGER STREAM QB2, 0.2 FILE 'b.txt'

SELECT * STREAM multi1 FROM (QA>2)#(QB>1)
SELECT * STREAM multi2 FROM (QA>2)#(QB>1)
SELECT * STREAM multi_reference FROM (QA2#QB2)>3

# Powtórzone DA+DB tworzy substrat, który może zostać scalony z dedup_owner.
DECLARE value INTEGER STREAM DA, 0.1 FILE 'a.txt'
DECLARE value INTEGER STREAM DB, 0.1 FILE 'b.txt'
DECLARE value INTEGER STREAM DA2, 0.1 FILE 'a.txt'
DECLARE value INTEGER STREAM DB2, 0.1 FILE 'b.txt'

SELECT * STREAM dedup_owner FROM DA+DB
SELECT dedup_shifted[0],dedup_shifted[1] STREAM dedup_shifted FROM (DA+DB)>1
SELECT * STREAM dedup_reference_owner FROM DA2+DB2
SELECT dedup_reference[0],dedup_reference[1] STREAM dedup_reference FROM (DA2+DB2)>1

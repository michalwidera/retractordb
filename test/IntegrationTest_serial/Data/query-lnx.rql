DECLARE a INTEGER,b INTEGER STREAM core0, .1 FILE 'datafile2.dat'
DECLARE c INTEGER,d INTEGER STREAM core1, 0.05 FILE 'datafile3.dat'
# Bylo: `SELECT core0[0],core0[1] ...` — odwolanie do skladnika przeplotu, od bramki F9
# (D-F1 = S3) blad kompilacji. Zapis przez nazwe strumienia wynikowego liczy to samo.
SELECT str1[0],str1[1] STREAM str1 FROM core0#core1
SELECT (core1[0]+1)*2+1,1 STREAM str2 FROM core1-1/2
SELECT core0[0],core0[1] STREAM str3 FROM core1+core0
SELECT * STREAM str4 FROM core0&2
SELECT * STREAM str5 FROM core0%0.5

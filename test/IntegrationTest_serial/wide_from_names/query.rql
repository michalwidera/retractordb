SUBSTRAT 'default'

DECLARE v INTEGER STREAM str01, 1 FILE 'd01.txt'
DECLARE v INTEGER STREAM str02, 1 FILE 'd02.txt'
DECLARE v INTEGER STREAM str03, 1 FILE 'd03.txt'
DECLARE v INTEGER STREAM str04, 1 FILE 'd04.txt'
DECLARE v INTEGER STREAM str05, 1 FILE 'd05.txt'
DECLARE v INTEGER STREAM str06, 1 FILE 'd06.txt'
DECLARE v INTEGER STREAM str07, 1 FILE 'd07.txt'
DECLARE v INTEGER STREAM str08, 1 FILE 'd08.txt'
DECLARE v INTEGER STREAM str09, 1 FILE 'd09.txt'
DECLARE v INTEGER STREAM str10, 1 FILE 'd10.txt'
DECLARE v INTEGER STREAM str11, 1 FILE 'd11.txt'
DECLARE v INTEGER STREAM str12, 1 FILE 'd12.txt'
DECLARE v INTEGER STREAM str13, 1 FILE 'd13.txt'
DECLARE v INTEGER STREAM str14, 1 FILE 'd14.txt'

SELECT * STREAM wide FROM str01+str02+str03+str04+str05+str06+str07+str08+str09+str10+str11+str12+str13+str14
SELECT * STREAM reduced FROM SUMC(wide@(1,3))

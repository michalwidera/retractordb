# Agregat okna REKORDOWEGO w liscie SELECT: AGG(pole : szerokosc).
#
# Szerokosc liczy REKORDY, nie elementy plaskie, wiec pole `INTEGER[3]` przy szerokosci 2
# redukuje 6 wartosci. Okno jest PRZESUWNE i stemplowane koncem: rekord wyjsciowy n obejmuje
# rekordy zrodla n-(szerokosc-1) ... n, a interwal wyjscia jest ROWNY interwalowi zrodla —
# lista SELECT nie rusza osi czasu, kazda zmiana taktu nalezy do klauzuli FROM.
#
# Wartosci oczekiwane sa policzone RECZNIE w pattern.txt, a nie porownane z inna
# konstrukcja silnika — poza jednym przypadkiem, ktory jest tozsamoscia i dlatego
# nadaje sie na kotwice: MIN(a:1) redukuje pola biezacego rekordu, czyli dokladnie
# to samo co reduktor strumieniowy FROM MIN(src).
STORAGE 'temp'
SUBSTRAT 'memory'

DECLARE a INTEGER[3] STREAM src, 1 FILE 'data.txt'
DECLARE c INTEGER STREAM sc, 1 FILE 'scalar.txt'

# Cztery agregaty jednego ksztaltu: jedna grupa, jedno przejscie po oknie. Liczba rekordow
# pilnuje przy okazji interwalu — okno o szerokosci 2 wydaje wynik co rekord zrodla, wiec
# przy `-m 8` powstaje ich szesc, a nie trzy.
SELECT MIN(a : 2), MAX(a : 2), SUMC(a : 2), AVG(a : 2) STREAM sliding FROM src

# Kopia strumienia z oknem. Schemat wezla pochodnego materializuje sie ZANIM ustali sie typ
# wyniku okna, wiec bez przebiegu propagateCopiedFieldShapes() to pole nosiloby domyslny
# INTEGER parsera i przycinaloby RATIONAL po cichu: 29/6 wychodzilo jako 4.
SELECT * STREAM shifted FROM sliding>1

# Szerokosc 1: redukcja pol JEDNEGO rekordu.
SELECT MIN(a : 1), SUMC(a : 1) STREAM single FROM src

# Kotwica metamorficzna dla powyzszego.
SELECT * STREAM ref_single FROM MIN(src)
SELECT * STREAM ref_sum FROM SUMC(src)

# Zrodlo skalarne: slotCount = 1, inna sciezka niz tablica.
SELECT MIN(c : 3), SUMC(c : 3) STREAM scalar3 FROM sc

# Zrodlo POCHODNE, nie deklarowane: inna galaz rachunku pojemnosci historii
# (deklaracja wyprzedza konsumenta o rekord uzbrojony i zerowy prefetch, pochodna nie).
SELECT c * 10 STREAM scaled FROM sc
SELECT MIN(scaled_0 : 3), SUMC(scaled_0 : 3) STREAM derived3 FROM scaled

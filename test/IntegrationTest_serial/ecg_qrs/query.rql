# Potok EKG Pan-Tompkins — flagowy przyklad artykulu (sekcja "Example D").
#
# Plan wyprowadzony z examples/ecg/rec205/rec205-qrs.rql BEZ ZMIAN SEMANTYCZNYCH.
# Rozni sie od oryginalu wylacznie:
#   - nazwa pliku zrodlowego ('ecgdata' zamiast 'rec205' — prefiks 2000 probek),
#   - dyrektywa STORAGE,
#   - zdjeciem VOLATILE z trzech obserwowanych strumieni (bp_out, mwi, qrs_out),
#     bez czego nie powstalby zaden artefakt do porownania ze wzorcem.
# Zadna z tych roznic nie dotyka operatora okna @ ani sumy strumieni +, czyli
# wielkosci, ktorych ten test broni.
#
# Powod istnienia testu: scalenie 5f31051 ("Issue 227 precesja") przestemplowalo
# okno @ z poczatku na koniec przedzialu i przenioslo rozpietosc okna z ogona do
# query::logicalOrigin — czyli dotknelo dokladnie operatora, na ktorym ten potok
# stoi. Regresja "plaski wykres detekcji QRS" byla kiedys znaleziona przez ten
# przyklad, a nie przez zestaw testow (patrz komentarz w test_compiler.cpp przy
# agse_capacity_covers_whole_window_over_computed_source).

STORAGE 'temp'

# Okna wydzielone z klauzuli FROM sa substratami kompilatora, wiec nie obejmuje ich
# VOLATILE zapytania nadrzednego. 'memory' trzyma je tam, gdzie stalyby nazwane okna
# w oryginale — w pamieci, a nie w temp/.
SUBSTRAT 'memory'

DECLARE MLII INTEGER, V1 INTEGER STREAM ecg, 1/360 FILE 'ecgdata'
DECLARE bp_coef INTEGER[25] STREAM bpf, 1 FILE 'bp_coef.txt'
DECLARE d_coef INTEGER[5] STREAM df, 1 FILE 'd_coef.txt'

# Wyodrebnienie kanalu MLII
SELECT ecg.MLII STREAM mlii FROM ecg VOLATILE

# 1. Filtr pasmowoprzepustowy (5-15 Hz) — splot FIR 25-tap
SELECT mlii[_]*bpf[_] STREAM bp_acc FROM mlii@(1,25)+bpf VOLATILE
SELECT bp_acc[0]/1000 STREAM bp_out FROM SUMC(bp_acc)

# 2. Rozniczkowanie — splot FIR 5-tap
SELECT bp_out[_]*df[_] STREAM d_acc FROM bp_out@(1,5)+df VOLATILE
SELECT d_acc[0] STREAM d_out FROM SUMC(d_acc) VOLATILE

# 3. Kwadrat (dzielenie /1000 zapobiega przepelnieniu int32)
SELECT d_out[0]^2/1000 STREAM sq_out FROM d_out VOLATILE

# 4. Calkowanie w oknie ruchomym 30 probek (~83 ms)
SELECT sq_out[0] STREAM mwi FROM AVG(sq_out@(1,30))

# 5. Prog adaptacyjny — srednia ruchoma 180 probek (0.5 s)
SELECT mwi[0] STREAM mwi_thr FROM AVG(mwi@(1,180)) VOLATILE

# Wyjscie: MLII wycentrowane, obwiednia x5, sygnal detekcji x5
SELECT mlii[0]-900, mwi[0]*5, (mwi[0]-mwi_thr[0]*2)*5 STREAM qrs_out FROM mlii+mwi+mwi_thr

# 6. Zdziesiatkowana obwiednia szczytowa filtru pasmowego (~51,4 Hz)
#    — WEZEL DODANY WZGLEDEM ORYGINALU.
#
# Powod: caly potok Pan-Tompkinsa uzywa okien o kroku 1 nad zrodlami o jednym
# polu, wiec iloraz (1+W_src)*F/step jest w kazdym jego wezle CALKOWITY i
# mutacja ceil->floor w AgseStartupLatency nie zmienia w nim niczego. Bramka,
# ktora przechodzi takze dla reguly obalonej, niczego nie strzeze — potrzebny
# jest wezel o ilorazie ulamkowym. Krok 7 nad bp_out (W_src=359, F=1) daje
# ogon = ceil(360/7)-1 = 51, a przy floor 50.
#
# Zrodlem jest bp_out, a nie mwi, bo bp_out niesie 76 roznych wartosci, a mwi
# tylko trzy — po zdziesiatkowaniu mwi wzorzec rozrozniałby przesuniecie
# wylacznie liczba rekordow, nie trescia.
SELECT bp_out[0] STREAM bp_dec FROM MAX(bp_out@(7,-21))

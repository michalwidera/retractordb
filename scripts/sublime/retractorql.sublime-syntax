%YAML 1.2
---
# http://www.sublimetext.com/docs/3/syntax.html

# https://github.com/sharkdp/bat#adding-new-syntaxes--language-definitions
# Install via buildrdb.sh:
#   scripts/buildrdb.sh batsyntax
# Or manually (bat/batcat depending on distro):
#   BAT=$(command -v batcat || command -v bat)
#   mkdir -p "$("$BAT" --config-dir)/syntaxes"
#   cp scripts/sublime/retractorql.sublime-syntax "$("$BAT" --config-dir)/syntaxes/"
#   "$BAT" cache --build

name: RetractorQL
file_extensions:
  - rql
  - desc
scope: source.rql

contexts:
  main:
    # Nazwy deklaracji LET/VAR i wspolne odwolania ?NAZWA.
    - match: (?<![A-Za-z_$0-9])(LET|let|VAR|var)(\s+)([A-Za-z][A-Za-z_0-9]*)(?![A-Za-z_$0-9])
      captures:
        1: keyword.control.rql
        3: variable.other.rql
    - match: \?[A-Za-z][A-Za-z_0-9]*(?![A-Za-z_$0-9])
      scope: variable.other.rql
    # RQL statement keywords
    - match: (?<![A-Za-z_$0-9])(SELECT|select|STREAM|stream|FROM|from|DECLARE|declare|LET|let|VAR|var|SET|set|FILE|file|BINFILE|binfile|TEXTFILE|textfile|DEVICE|device|VOLATILE|volatile|PERSISTENT|persistent|RULE|rule|ON|on|WHEN|when|DO|do|DUMP|dump|TO|to|SYSTEM|system|DISPOSABLE|disposable|ONESHOT|oneshot|HOLD|hold|TIMEOUT|timeout|RETENTION|retention)(?![A-Za-z_$0-9])
      scope: keyword.control.rql
    # Compiler option directives
    - match: (?<![A-Za-z_$0-9])(STORAGE|storage|ROTATION|rotation|SUBSTRAT|substrat)(?![A-Za-z_$0-9])
      scope: keyword.other.directive.rql
    # Logical operators
    - match: (?<![A-Za-z_$0-9])(AND|and|OR|or|NOT|not)(?![A-Za-z_$0-9])
      scope: keyword.operator.logical.rql
    # Storage profile values (TYPE_PROFILE)
    - match: (?<![A-Za-z_$0-9])(MEMORY|memory|DEFAULT|default|DIRECT|direct|POSIX|posix|POSIXSHD|posixshd|GENERIC|generic)(?![A-Za-z_$0-9])
      scope: support.constant.rql
    - match: "'"
      push: string
    - include: comments
    - include: numbers
    - include: types
    - include: aggregators
    - include: functions
    - include: desc_keywords
    - match: '[:=<>!#&%@+$*/~^|-]+'
      scope: keyword.operator.rql

  string:
    - meta_scope: string.quoted.single.rql
    - match: "''"
      scope: constant.character.escape.rql
    - match: "'"
      pop: true

  comments:
    - match: '^[ \t]*#.*'
      scope: comment.line.hash.rql
    - match: //.*
      scope: comment.line.double-slash.rql
    - match: /\*
      push: block_comment

  block_comment:
    - meta_scope: comment.block.rql
    - match: /\*
      push: block_comment
    - match: \*/
      pop: true

  numbers:
    - match: \b[0-9]+/[0-9]+\b
      scope: constant.numeric.rational.rql
    - match: (?:\b[0-9]+(?:\.[0-9]*)?|\B\.[0-9]+)E[+-]?[0-9]+\b
      scope: constant.numeric.float.rql
    - match: (?:\b[0-9]+\.[0-9]*|\B\.[0-9]+)
      scope: constant.numeric.float.rql
    - match: \b[0-9]+\b
      scope: constant.numeric.integer.rql

  types:
    - match: (?<![A-Za-z_$0-9])(INTEGER|Integer|BYTE|Byte|CHAR|Char|UINT|Uint|STRING|String|FLOAT|Float|DOUBLE|Double|RATIONAL|Rational)(?![A-Za-z_$0-9])
      scope: storage.type.rql

  desc_keywords:
    # DESC.g4 meta-commands
    - match: (?<![A-Za-z_$0-9])(REF|TYPE|RETMEMORY|INTPAIR|IDXPAIR)(?![A-Za-z_$0-9])
      scope: constant.other.rql

  aggregators:
    - match: (?<![A-Za-z_$0-9])(MIN|min|MAX|max|AVG|avg|SUMC|sumc)(?![A-Za-z_$0-9])
      scope: support.function.aggregate.rql

  functions:
    # Funkcje i skroty z src/include/rqlFunctions.hpp.
    - match: (?<![A-Za-z_$0-9])(?i:sqrt|ceil|floor|abs|round|trunc|sin|cos|exp|tan|log2|log|isnull|null2zero|iszero|isnonzero|length|to_integer|to_float|to_double|to_string|int|float|real|str)(?![A-Za-z_$0-9])(?=\s*\()
      scope: support.function.rql

# docs/ bylo katalogiem wyjscia generatora i zostalo usuniete z master w
# 53c304b9 ("Remove docs from main branch"). Od tej pory trzyma rowniez
# trwala dokumentacje programu osadzania, wiec ignorujemy jego ZAWARTOSC
# poza plikami .md - wyjscie generatora nadal nie wchodzi do repozytorium.
docs/*
!docs/*.md
bin/*
/lib/
.venv/
# Srodowiska wirtualne tworzone w drzewie: .venv-python (scripts/python-venv.sh)
# i .venv-api z api/python/README.md. Wzorzec obejmuje oba i kazde nastepne.
.venv-*/
.codex/*
!.codex/config.toml
dokumentacja-rdb/
docker/ci/DockerConan.txt
docker/ci/DockerConanExtra.txt
205.bin
205.bin.meta

# Bramka badawcza test/research_gate: cache bajtkodu Pythona i artefakty
# przebiegow. Aparatura kampanii importuje sie modulami wewnatrz swojego
# katalogu, wiec kazdy przebieg zostawia __pycache__ obok zrodel; katalogi
# work/ i .gate-work/ to wyjscia przebiegu, odtwarzalne z ziarna.
__pycache__/
*.pyc
test/research_gate/**/work/
test/research_gate/.gate-work/
test/research_gate/.drift-work/
test/research_gate/.drift.lock

# Wyjscia uruchomienia bramki badawczej pisane obok aparatury: `validate_corpus.py`
# bez --out zapisuje corpus_validation/, `run_campaign.py` bez --out zapisuje raw/.
# To dowody kompilacji konkretnej rewizji, nie zrodla - do repozytorium nie wchodza.
test/research_gate/**/corpus_validation/
test/research_gate/**/raw/

# Dowody Lean (math_proofs/): katalog roboczy Lake to dowiazanie do ~/.cache (link-lake.sh).
# Wzorzec BEZ koncowego ukosnika - `.lake/` pasuje tylko do katalogu, nie do dowiazania,
# i test-ci.sh (git ls-files -co --exclude-standard) wrzucilby zerwany link do kontenera.
.lake

# Dokumenty projektowe (design/) sa notatkami roboczymi, nie zrodlem prawdy:
# trwala dokumentacja programu osadzania zyje w docs/. Trzymane poza repozytorium,
# zeby kolejne rewizje roadmapy nie generowaly diffow w historii kodu.
design/

# Artefakty Findera na macOS - platforma rozwojowa, wiec pojawiaja sie w kazdym katalogu.
.DS_Store

# Wyjscia budowy rozszerzenia Pythona (RDB_PYTHON=ON). Modul kompilowany trafia do
# katalogu build, a instalacja editable zostawia te katalogi obok pakietu.
api/python/**/*.so
api/python/**/*.pyd
api/python/build/
api/python/dist/
api/python/*.egg-info/
.pytest_cache/

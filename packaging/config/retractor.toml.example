# Przykładowa konfiguracja usługi xretractor (RetractorDB).
#
# Pliki konfiguracyjne są OPCJONALNE - bez nich xretractor startuje z domyślnymi
# ustawieniami. Aby aktywować, skopiuj ten plik jako żywą konfigurację:
#
#   sudo cp /etc/retractor/retractor.toml.example /etc/retractor/retractor.toml
#
# Wyszukiwanie warstwowe (kolejna warstwa nadpisuje klucze poprzedniej):
#   1. /etc/retractor/retractor.toml                       (systemowa)
#   2. $XDG_CONFIG_HOME (lub ~/.config)/retractor/retractor.toml  (użytkownika)
# Jawny plik: xretractor --config /ścieżka/do/pliku.toml (wyłącza wyszukiwanie).

[storage]
# Domyślny katalog na artefakty (pliki danych strumieni, .desc, .meta).
# Stosowany wyłącznie gdy zestaw RQL nie zdefiniował własnej dyrektywy :STORAGE
# (dyrektywa w .rql ma pierwszeństwo). Końcowy '/' jest opcjonalny.
dir = "/var/lib/retractor"

# Retencja strumieni zapisywanych na dysku, które w RQL nie mają klauzuli RETENTION:
# [pojemność segmentu w rekordach, liczba segmentów], obie liczby > 0. Działa jak dopisanie
# `RETENTION pojemność segmenty` do każdego takiego SELECT - także do strumieni pośrednich,
# które kompilator wydziela z wyrażeń - w magazynach DEFAULT i DIRECT. POSIX, POSIXSHD
# i GENERIC retencji nie mają, a strumienie MEMORY i tak są pierścieniem w RAM.
#
# Domyślnie klucza nie ma: historia rośnie na dysku bez granicy, a xretractor przy starcie
# i w `-c` wypisuje na stderr strumienie, których to dotyczy. Klucz KASUJE najstarsze segmenty,
# dlatego jest decyzją operatora, nie ustawieniem domyślnym. Plan, który czyta wstecz więcej
# rekordów, niż retencja gwarantuje ((segmenty - 1) * pojemność + 1), jest odrzucany jako błąd
# kompilacji. Retencja trafia do .desc strumienia. Przy dyrektywie ROTATION pliki strumienia
# zostają między startami, więc dodanie albo zmiana tego klucza przy zachowanych plikach jest
# odmową startu z nazwą strumienia - trzeba przywrócić poprzednią wartość albo usunąć jego pliki.
# Niepoprawna wartość jest pomijana z ostrzeżeniem w dzienniku.
# default_retention = [100000, 10]

# Katalogi poza katalogiem magazynu, do których pole REF zachowanego pliku .desc może przenieść
# zapisywalny plik danych (czyta xtrdb). Bez klucza REF wzięty z .desc zapisuje i usuwa tylko
# w katalogu magazynu: `open` takiego magazynu jest odmową, a `quitdrop` usuwa sam .desc. Odczyt
# źródeł BINFILE, TEXTFILE i DEVICE przez REF oraz REF z planu nie podlegają temu ograniczeniu.
# Wpisy: bezwzględne ścieżki istniejących katalogów - inny wpis zatrzymuje start xtrdb.
# ref_dirs = ["/srv/retractor/archive"]

# [sources]
# Termin odczytu źródeł DEVICE (urządzenie znakowe albo FIFO) w sekundach, gdy deklaracja w RQL
# nie ma klauzuli TIMEOUT. 0 (domyślnie, także bez klucza) to jedna próba natychmiastowa: brak
# pełnego rekordu w należnym takcie daje rekord all-null bez czekania. Wartość t > 0 to jeden termin
# na cały rekord, liczony od początku należnego slotu; wszystkie DEVICE jednego slotu czekają
# równolegle, więc slot wydłuża się najwyżej o największy termin, nie o ich sumę. Jawna klauzula
# w RQL wygrywa - także `TIMEOUT 0`, które wyłącza tę wartość dla jednego źródła. W trybie bez zegara
# (`xretractor -f`) termin wynosi zawsze 0. Wartość ujemna, NaN, nieliczba albo większa od 86400
# zatrzymuje start xretractora błędem konfiguracji (nie ma terminu "czekaj bez końca"). Klucz nie
# zmienia BINFILE, TEXTFILE ani timing.query_no_data_timeout_ms klienta xqry.
# timeout_s = 0.0

# [service]
# Plik zapytań nadpisywany, gdy nowa instancja przekazuje zestaw działającemu serwisowi
# (xretractor wykrywa serwis, nadpisuje ten plik i zleca restart jednostki). Używany tylko
# jako fallback - w normalnym przebiegu serwis sam raportuje swój plik zapytań. MUSI być
# zgodny z argumentem ExecStart jednostki systemd (zmiana tutaj nie zmienia ExecStart).
# query_file = "/etc/retractor/startup.rql"
#
# Dopuszczenie reguły `DO SYSTEM` w planie przyjmowanym kanałem `xqry --reset`.
#
# Domyślnie (false) taki plan jest odrzucany w CAŁOŚCI, bo kanał reset nie niesie autorstwa:
# regułę uruchamiającą dowolne polecenie powłoki wolno zamówić tylko w pliku planu, którego
# autorem jest operator usługi. Kanał ad-hoc odmawia jej bezwarunkowo i tego klucza nie czyta.
#
# Ustaw `true` WYŁĄCZNIE wtedy, gdy świadomie oddajesz ten kanał: usługa instalowana z pakietu
# wstaje z pustym planem, więc `--reset` jest jej jedyną bezprzywilejową drogą podania zestawu,
# a przy `true` każdy, kto potrafi otworzyć obiekty IPC tej instancji, wykona polecenie powłoki
# na jej koncie. Obiekty IPC są tworzone z trybem 0600, więc granicą jest konto usługi.
# Włączenie zostawia ostrzeżenie w dzienniku przy każdym starcie.
# unrestricted = false

# [limits]
# Budżet pamięci historii planu w MiB. Historię w RAM trzymają źródła deklarowane (DECLARE)
# i strumienie w magazynie MEMORY (VOLATILE, SUBSTRAT 'memory'): każdy slot kosztuje rozmiar
# rekordu plus ok. 170 B narzutu, a liczba slotów wynika z planu - okna `@`, przesunięcia `>N`,
# okna rekordowe, zakres DUMP. Plan, który go przekracza, jest odrzucany jako błąd kompilacji:
# przy starcie, w `xretractor -c`, w kanale ad-hoc i przy `xqry --reset`. Wartość musi być > 0;
# niepoprawna zostaje zastąpiona domyślną z ostrzeżeniem w dzienniku.
# history_memory_mib = 1024
